{
  "name": "dsh-spec-driven-development",
  "version": "0.1.0",
  "description": "Spec-driven software development workflow for DeepSeek Harness",
  "type": "module",
  "main": "./dsh-plugin/index.js",
  "exports": {
    ".": "./dsh-plugin/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh-plugin/index.js",
    "skills/spec-driven-development",
