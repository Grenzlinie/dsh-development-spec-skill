    "check:dsh": "python3 scripts/sync_dsh_plugin.py --check && python3 scripts/verify_dsh_package.py",
    "test": "node --test tests/dsh-plugin.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-skill",
    "spec-driven-development"
