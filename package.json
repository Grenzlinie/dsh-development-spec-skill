  "author": "Grenzlinie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grenzlinie/dsh-development-spec-skill.git"
  },
  "homepage": "https://github.com/Grenzlinie/dsh-development-spec-skill#readme",
  "bugs": {
    "url": "https://github.com/Grenzlinie/dsh-development-spec-skill/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
