{
  "version": 1,
  "require_claude_symlink": true,
  "verification_commands": [
    {
      "name": "tests",
      "command": [".venv/bin/python", "-m", "pytest", "-q"]
    },
    {
      "name": "ruff",
      "command": [".venv/bin/python", "-m", "ruff", "check", "."]
    },
    {
      "name": "build",
      "command": [".venv/bin/python", "-m", "build"]
    }
  ]
}
