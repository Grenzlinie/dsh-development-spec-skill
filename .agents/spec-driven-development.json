{
  "version": 1,
  "require_claude_symlink": true,
  "verification_commands": [
    {
      "name": "specctl-unittest",
      "command": ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"]
    },
    {
      "name": "markdown-links",
      "command": ["python3", "scripts/check_markdown_links.py", "."]
    },
    {
      "name": "experiment-integrity",
      "command": ["python3", "scripts/verify_experiment.py"]
    },
    {
      "name": "publication-artifacts",
      "command": ["python3", "scripts/verify_publication.py"]
    },
    {
      "name": "dsh-skill-projection",
      "command": ["python3", "scripts/sync_dsh_plugin.py", "--check"]
    },
    {
      "name": "dsh-plugin-unit",
      "command": ["node", "--test", "tests/dsh-plugin.test.mjs"]
    },
    {
      "name": "dsh-package-boundary",
      "command": ["python3", "scripts/verify_dsh_package.py"]
    }
  ]
}
